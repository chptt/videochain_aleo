# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite — no setup needed. File is created automatically.
DATABASE_URL="file:./prisma/videochain.db"

# ─── Auth / Sessions ───────────────────────────────────────────────────────────
# Signs short-lived playback JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex

# ─── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM master key for encrypting video content (32 bytes = 64 hex chars)
MASTER_ENCRYPTION_KEY=replace_with_64_char_hex
# Wrapping key for per-content keys
KEY_WRAP_SECRET=replace_with_another_64_char_hex

# ─── Storage ───────────────────────────────────────────────────────────────────
# Choose: walrus | pinata | local
STORAGE_PROVIDER=walrus

# Walrus (decentralised, no account needed on testnet)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Pinata (IPFS pinning — needs free account at pinata.cloud)
# STORAGE_PROVIDER=pinata
# PINATA_API_KEY=your_key
# PINATA_SECRET_API_KEY=your_secret
# PINATA_GATEWAY=https://gateway.pinata.cloud

# Local (dev fallback — files stored in ./storage/uploads)
# STORAGE_PROVIDER=local

# ─── Aleo ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALEO_NETWORK=testnet3
ALEO_PROGRAM_ID=video_entitlement.aleo
# Only needed after you deploy the Leo program:
# ALEO_PRIVATE_KEY=APrivateKey1zkp...
# ALEO_VIEW_KEY=AViewKey1...
ALEO_RPC_URL=https://api.explorer.aleo.org/v1

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PLAYBACK_PER_MIN=10

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
